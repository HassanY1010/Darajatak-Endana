# ====== إعدادات الخادم ======
PORT=3000
NODE_ENV=production

# ====== الأمان ======
# مفتاح سري لتوقيع JWT — غيّره إلى قيمة عشوائية طويلة في الإنتاج!
JWT_SECRET=change_this_to_a_long_random_secret_string_2026
JWT_EXPIRES_IN=12h

# ====== حساب المدير الافتراضي (يُنشأ عند أول تشغيل seed) ======
ADMIN_EMAIL=admin@daragatuk.sa
ADMIN_PASSWORD=Admin@12345

# ====== إعدادات عامة ======
# الحد الأقصى لحجم الصورة بالميجابايت
MAX_UPLOAD_MB=5

# ====== قاعدة البيانات والتخزين الخارجي (Supabase) ======
DATABASE_URL=postgres://postgres:password@your-db-host.supabase.co:6543/postgres?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=motorcycles

# ====== نظام النسخ الاحتياطي واستعادة الكوارث (Backup & Disaster Recovery) ======
# المسار المحلي للنسخ الاحتياطي على جهازك (Windows)
BACKUP_ROOT=D:\دراجتك عندنا Backup
# عدد عمليات التحميل المتزامنة (حماية من Rate Limiting و Egress spike)
BACKUP_CONCURRENCY=3
# الفاصل الزمني لتشغيل الـ Backup Agent بالدقائق
BACKUP_INTERVAL_MINUTES=5
# أقصى عدد لمحاولات إعادة التنزيل عند الفشل (مع Exponential Backoff)
BACKUP_MAX_RETRIES=3

# ====== إعدادات الاستعادة إلى مشروع Supabase جديد (Disaster Recovery Restore) ======
TARGET_SUPABASE_URL=https://new-project.supabase.co
TARGET_SUPABASE_KEY=your-new-supabase-service-role-key
TARGET_SUPABASE_BUCKET=motorcycles

# ====== نظام النسخ الاحتياطي لقاعدة بيانات PostgreSQL (Database Disaster Recovery) ======
DATABASE_BACKUP_ROOT=D:\دراجتك عندنا Backup\Database
DATABASE_BACKUP_INTERVAL_MINUTES=60
DATABASE_BACKUP_MAX_RETRIES=3
DATABASE_BACKUP_RETENTION_DAILY=7
DATABASE_BACKUP_RETENTION_WEEKLY=4
DATABASE_BACKUP_RETENTION_MONTHLY=12
DATABASE_BACKUP_VERIFY=true
DATABASE_BACKUP_COMPRESS=true
DATABASE_BACKUP_TIMEOUT_MINUTES=30
DATABASE_BACKUP_CONCURRENCY=1
DATABASE_BACKUP_MIN_FREE_SPACE_MB=1024
RESTORE_TARGET_DATABASE_URL=postgres://postgres:password@your-new-db-host.supabase.co:6543/postgres?sslmode=require
RESTORE_REQUIRE_CONFIRMATION=true
